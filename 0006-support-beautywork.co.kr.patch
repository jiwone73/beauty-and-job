+        alert("support@beautywork.co.kr에서 답변 메일을 발송했습니다.");
+      } else {
+        alert(data.error?.message || "메일 발송에 실패했습니다.");
+      }
+    } catch (e) {
+      console.error("[send reply]", e);
+      alert("메일 발송 중 오류가 발생했습니다.");
+    }
   };
 
